# Copiá este archivo como .env.local para desarrollo local (vercel dev).
# En producción, estas variables se cargan en el panel de Vercel:
#   Project → Settings → Environment Variables

# Connection string de MongoDB Atlas (Driver → Node.js)
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base (opcional, por defecto "miscompras")
MONGODB_DB=miscompras
